{
  "type": "APL",
  "version": "2024.3",
  "theme": "dark",
  "mainTemplate": {
    "parameters": [
      "solarData",
      "chartData"
    ],
    "item": {
      "type": "Container",
      "width": "100vw",
      "height": "100vh",
      "items": [
        {
          "type": "Frame",
          "width": "100vw",
          "height": "100vh",
          "background": {
            "type": "linear",
            "colorRange": ["#25485E", "#5D9FD3"],
            "inputRange": [0, 1],
            "angle": 160
          },
          "item": {
            "type": "Container",
            "width": "100%",
            "height": "100%",
            "paddingTop": "4vh",
            "paddingBottom": "4vh",
            "paddingLeft": "8vw",
            "paddingRight": "8vw",
            "justifyContent": "spaceBetween",
            "items": [
              {
                "type": "Container",
                "direction": "row",
                "alignItems": "center",
                "spacing": "10dp",
                "items": [
                  {
                    "type": "Image",
                    "source": "https://alexa-fv-assets-126437.s3.eu-west-1.amazonaws.com/icons/icon-power.png",
                    "width": "32dp",
                    "height": "32dp"
                  },
                  {
                    "type": "Text",
                    "text": "Fotovoltaico",
                    "fontSize": "30dp",
                    "fontWeight": "700",
                    "color": "#FAFAFA"
                  }
                ]
              },
              {
                "type": "Container",
                "items": [
                  {
                    "type": "Text",
                    "text": "POTENZA ATTUALE",
                    "fontSize": "15dp",
                    "fontWeight": "600",
                    "color": "rgba(255,255,255,0.5)",
                    "letterSpacing": "1.5dp"
                  },
                  {
                    "type": "Container",
                    "direction": "row",
                    "alignItems": "baseline",
                    "spacing": "8dp",
                    "paddingTop": "4dp",
                    "items": [
                      {
                        "type": "Text",
                        "text": "${solarData.realTimePower}",
                        "fontSize": "60dp",
                        "fontWeight": "800",
                        "color": "#FFFFFF"
                      },
                      {
                        "type": "Text",
                        "text": "kW",
                        "fontSize": "24dp",
                        "fontWeight": "400",
                        "color": "rgba(255,255,255,0.45)",
                        "paddingLeft": "4"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Container",
                "when": "${chartData.areaPath}",
                "width": "100%",
                "maxWidth": "540dp",
                "items": [
                  {
                    "type": "Text",
                    "text": "CURVA DI PRODUZIONE",
                    "fontSize": "11dp",
                    "fontWeight": "600",
                    "color": "rgba(255,255,255,0.4)",
                    "letterSpacing": "1dp",
                    "paddingBottom": "6dp"
                  },
                  {
                    "type": "Frame",
                    "width": "100%",
                    "backgroundColor": "rgba(0,0,0,0.15)",
                    "borderRadius": "8dp",
                    "paddingTop": "10dp",
                    "paddingBottom": "10dp",
                    "paddingLeft": "8dp",
                    "paddingRight": "12dp",
                    "item": {
                      "type": "Container",
                      "items": [
                        {
                          "type": "Container",
                          "direction": "row",
                          "width": "100%",
                          "items": [
                            {
                              "type": "Container",
                              "width": "30dp",
                              "height": "140dp",
                              "justifyContent": "spaceBetween",
                              "paddingRight": "4dp",
                              "items": [
                                {
                                  "type": "Text",
                                  "text": "4",
                                  "fontSize": "10dp",
                                  "fontWeight": "400",
                                  "color": "rgba(255,255,255,0.35)",
                                  "textAlign": "right"
                                },
                                {
                                  "type": "Text",
                                  "text": "3",
                                  "fontSize": "10dp",
                                  "fontWeight": "400",
                                  "color": "rgba(255,255,255,0.35)",
                                  "textAlign": "right"
                                },
                                {
                                  "type": "Text",
                                  "text": "2",
                                  "fontSize": "10dp",
                                  "fontWeight": "400",
                                  "color": "rgba(255,255,255,0.35)",
                                  "textAlign": "right"
                                },
                                {
                                  "type": "Text",
                                  "text": "1",
                                  "fontSize": "10dp",
                                  "fontWeight": "400",
                                  "color": "rgba(255,255,255,0.35)",
                                  "textAlign": "right"
                                },
                                {
                                  "type": "Text",
                                  "text": "0",
                                  "fontSize": "10dp",
                                  "fontWeight": "400",
                                  "color": "rgba(255,255,255,0.35)",
                                  "textAlign": "right"
                                }
                              ]
                            },
                            {
                              "type": "VectorGraphic",
                              "grow": 1,
                              "height": "140dp",
                              "source": "powerCurveGraphic",
                              "scale": "fill",
                              "parameters": {
                                "areaPath": "${chartData.areaPath}",
                                "linePath": "${chartData.linePath}"
                              }
                            }
                          ]
                        },
                        {
                          "type": "Container",
                          "direction": "row",
                          "justifyContent": "spaceBetween",
                          "paddingLeft": "30dp",
                          "paddingTop": "4dp",
                          "items": [
                            {
                              "type": "Text",
                              "text": "08",
                              "fontSize": "10dp",
                              "color": "rgba(255,255,255,0.3)"
                            },
                            {
                              "type": "Text",
                              "text": "11",
                              "fontSize": "10dp",
                              "color": "rgba(255,255,255,0.3)"
                            },
                            {
                              "type": "Text",
                              "text": "14",
                              "fontSize": "10dp",
                              "color": "rgba(255,255,255,0.3)"
                            },
                            {
                              "type": "Text",
                              "text": "17",
                              "fontSize": "10dp",
                              "color": "rgba(255,255,255,0.3)"
                            },
                            {
                              "type": "Text",
                              "text": "20",
                              "fontSize": "10dp",
                              "color": "rgba(255,255,255,0.3)"
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "type": "Container",
                "items": [
                  {
                    "type": "Frame",
                    "width": "100%",
                    "maxWidth": "500dp",
                    "height": "1dp",
                    "backgroundColor": "rgba(255,255,255,0.12)"
                  },
                  {
                    "type": "Container",
                    "paddingTop": "14dp",
                    "spacing": "14dp",
                    "maxWidth": "500dp",
                    "items": [
                      {
                        "type": "Container",
                        "direction": "row",
                        "alignItems": "center",
                        "justifyContent": "spaceBetween",
                        "items": [
                          {
                            "type": "Container",
                            "direction": "row",
                            "alignItems": "center",
                            "spacing": "10dp",
                            "items": [
                              {
                                "type": "Image",
                                "source": "https://alexa-fv-assets-126437.s3.eu-west-1.amazonaws.com/icons/icon-today.png",
                                "width": "24dp",
                                "height": "24dp",
                                "opacity": 0.6
                              },
                              {
                                "type": "Text",
                                "text": "Oggi",
                                "fontSize": "20dp",
                                "fontWeight": "500",
                                "color": "rgba(255,255,255,0.6)"
                              }
                            ]
                          },
                          {
                            "type": "Container",
                            "direction": "row",
                            "alignItems": "baseline",
                            "spacing": "6dp",
                            "items": [
                              {
                                "type": "Text",
                                "text": "${solarData.dailyEnergy}",
                                "fontSize": "24dp",
                                "fontWeight": "700",
                                "color": "#FAFAFA"
                              },
                              {
                                "type": "Text",
                                "text": "kWh",
                                "fontSize": "14dp",
                                "fontWeight": "400",
                                "color": "rgba(255,255,255,0.4)",
                                "paddingLeft": "4"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "Container",
                        "direction": "row",
                        "alignItems": "center",
                        "justifyContent": "spaceBetween",
                        "items": [
                          {
                            "type": "Container",
                            "direction": "row",
                            "alignItems": "center",
                            "spacing": "10dp",
                            "items": [
                              {
                                "type": "Image",
                                "source": "https://alexa-fv-assets-126437.s3.eu-west-1.amazonaws.com/icons/icon-month.png",
                                "width": "24dp",
                                "height": "24dp",
                                "opacity": 0.6
                              },
                              {
                                "type": "Text",
                                "text": "Mese",
                                "fontSize": "20dp",
                                "fontWeight": "500",
                                "color": "rgba(255,255,255,0.6)"
                              }
                            ]
                          },
                          {
                            "type": "Container",
                            "direction": "row",
                            "alignItems": "baseline",
                            "spacing": "6dp",
                            "items": [
                              {
                                "type": "Text",
                                "text": "${solarData.monthEnergy}",
                                "fontSize": "24dp",
                                "fontWeight": "700",
                                "color": "#FAFAFA"
                              },
                              {
                                "type": "Text",
                                "text": "kWh",
                                "fontSize": "14dp",
                                "fontWeight": "400",
                                "color": "rgba(255,255,255,0.4)",
                                "paddingLeft": "4"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Text",
                    "text": "Aggiornato alle ${solarData.lastUpdated}",
                    "fontSize": "13dp",
                    "fontWeight": "400",
                    "color": "rgba(255,255,255,0.25)",
                    "paddingTop": "12dp"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "graphics": {
    "powerCurveGraphic": {
      "type": "AVG",
      "version": "1.2",
      "parameters": [
        "areaPath",
        "linePath"
      ],
      "width": 400,
      "height": 120,
      "items": [
        {
          "type": "path",
          "pathData": "M 0 0 L 400 0",
          "fill": "none",
          "stroke": "rgba(255,255,255,0.08)",
          "strokeWidth": 0.5,
          "strokeDashArray": [4, 4]
        },
        {
          "type": "path",
          "pathData": "M 0 30 L 400 30",
          "fill": "none",
          "stroke": "rgba(255,255,255,0.08)",
          "strokeWidth": 0.5,
          "strokeDashArray": [4, 4]
        },
        {
          "type": "path",
          "pathData": "M 0 60 L 400 60",
          "fill": "none",
          "stroke": "rgba(255,255,255,0.08)",
          "strokeWidth": 0.5,
          "strokeDashArray": [4, 4]
        },
        {
          "type": "path",
          "pathData": "M 0 90 L 400 90",
          "fill": "none",
          "stroke": "rgba(255,255,255,0.08)",
          "strokeWidth": 0.5,
          "strokeDashArray": [4, 4]
        },
        {
          "type": "path",
          "pathData": "${areaPath}",
          "fill": "rgba(255,255,255,0.12)",
          "stroke": "none"
        },
        {
          "type": "path",
          "pathData": "${linePath}",
          "fill": "none",
          "stroke": "rgba(255,255,255,0.6)",
          "strokeWidth": 1.5
        }
      ]
    }
  }
}

{
  "type": "APL",
  "version": "2024.3",
  "theme": "dark",
  "mainTemplate": {
    "parameters": [
      "solarData"
    ],
    "item": {
      "type": "Container",
      "width": "100vw",
      "height": "100vh",
      "items": [
        {
          "type": "Frame",
          "width": "100vw",
          "height": "100vh",
          "background": {
            "type": "linear",
            "colorRange": ["#25485E", "#5D9FD3"],
            "inputRange": [0, 1],
            "angle": 160
          },
          "item": {
            "type": "Container",
            "width": "100%",
            "height": "100%",
            "paddingTop": "5vh",
            "paddingBottom": "5vh",
            "paddingLeft": "8vw",
            "paddingRight": "8vw",
            "justifyContent": "spaceBetween",
            "items": [
              {
                "type": "Container",
                "direction": "row",
                "alignItems": "center",
                "spacing": "10dp",
                "items": [
                  {
                    "type": "Image",
                    "source": "https://alexa-fv-assets-126437.s3.eu-west-1.amazonaws.com/icons/icon-power.png",
                    "width": "32dp",
                    "height": "32dp"
                  },
                  {
                    "type": "Text",
                    "text": "Fotovoltaico",
                    "fontSize": "30dp",
                    "fontWeight": "700",
                    "color": "#FAFAFA"
                  }
                ]
              },
              {
                "type": "Container",
                "grow": 1,
                "justifyContent": "center",
                "items": [
                  {
                    "type": "Text",
                    "text": "POTENZA ATTUALE",
                    "fontSize": "15dp",
                    "fontWeight": "600",
                    "color": "rgba(255,255,255,0.5)",
                    "letterSpacing": "1.5dp"
                  },
                  {
                    "type": "Container",
                    "direction": "row",
                    "alignItems": "baseline",
                    "spacing": "8dp",
                    "paddingTop": "6dp",
                    "items": [
                      {
                        "type": "Text",
                        "text": "${solarData.realTimePower}",
                        "fontSize": "72dp",
                        "fontWeight": "800",
                        "color": "#FFFFFF"
                      },
                      {
                        "type": "Text",
                        "text": "kW",
                        "fontSize": "26dp",
                        "fontWeight": "400",
                        "color": "rgba(255,255,255,0.45)",
                        "paddingLeft": "4"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Container",
                "items": [
                  {
                    "type": "Frame",
                    "width": "100%",
                    "maxWidth": "500dp",
                    "height": "1dp",
                    "backgroundColor": "rgba(255,255,255,0.12)"
                  },
                  {
                    "type": "Container",
                    "paddingTop": "20dp",
                    "spacing": "18dp",
                    "maxWidth": "500dp",
                    "items": [
                      {
                        "type": "Container",
                        "direction": "row",
                        "alignItems": "center",
                        "justifyContent": "spaceBetween",
                        "items": [
                          {
                            "type": "Container",
                            "direction": "row",
                            "alignItems": "center",
                            "spacing": "10dp",
                            "items": [
                              {
                                "type": "Image",
                                "source": "https://alexa-fv-assets-126437.s3.eu-west-1.amazonaws.com/icons/icon-today.png",
                                "width": "24dp",
                                "height": "24dp",
                                "opacity": 0.6
                              },
                              {
                                "type": "Text",
                                "text": "Oggi",
                                "fontSize": "20dp",
                                "fontWeight": "500",
                                "color": "rgba(255,255,255,0.6)"
                              }
                            ]
                          },
                          {
                            "type": "Container",
                            "direction": "row",
                            "alignItems": "baseline",
                            "spacing": "6dp",
                            "items": [
                              {
                                "type": "Text",
                                "text": "${solarData.dailyEnergy}",
                                "fontSize": "24dp",
                                "fontWeight": "700",
                                "color": "#FAFAFA"
                              },
                              {
                                "type": "Text",
                                "text": "kWh",
                                "fontSize": "14dp",
                                "fontWeight": "400",
                                "color": "rgba(255,255,255,0.4)",
                                "paddingLeft": "4"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "Container",
                        "direction": "row",
                        "alignItems": "center",
                        "justifyContent": "spaceBetween",
                        "items": [
                          {
                            "type": "Container",
                            "direction": "row",
                            "alignItems": "center",
                            "spacing": "10dp",
                            "items": [
                              {
                                "type": "Image",
                                "source": "https://alexa-fv-assets-126437.s3.eu-west-1.amazonaws.com/icons/icon-month.png",
                                "width": "24dp",
                                "height": "24dp",
                                "opacity": 0.6
                              },
                              {
                                "type": "Text",
                                "text": "Mese",
                                "fontSize": "20dp",
                                "fontWeight": "500",
                                "color": "rgba(255,255,255,0.6)"
                              }
                            ]
                          },
                          {
                            "type": "Container",
                            "direction": "row",
                            "alignItems": "baseline",
                            "spacing": "6dp",
                            "items": [
                              {
                                "type": "Text",
                                "text": "${solarData.monthEnergy}",
                                "fontSize": "24dp",
                                "fontWeight": "700",
                                "color": "#FAFAFA"
                              },
                              {
                                "type": "Text",
                                "text": "kWh",
                                "fontSize": "14dp",
                                "fontWeight": "400",
                                "color": "rgba(255,255,255,0.4)",
                                "paddingLeft": "4"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Text",
                    "text": "Aggiornato alle ${solarData.lastUpdated}",
                    "fontSize": "13dp",
                    "fontWeight": "400",
                    "color": "rgba(255,255,255,0.25)",
                    "paddingTop": "16dp"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}

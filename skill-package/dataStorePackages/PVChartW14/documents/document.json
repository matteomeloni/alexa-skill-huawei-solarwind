{
  "type": "APL",
  "version": "2024.3",
  "extensions": [
    {
      "name": "DataStore",
      "uri": "alexaext:datastore:10"
    }
  ],
  "settings": {
    "DataStore": {
      "dataBindings": [
        {
          "namespace": "fotovoltaico",
          "key": "realtime",
          "dataBindingName": "solarData",
          "dataType": "object"
        }
      ]
    }
  },
  "mainTemplate": {
    "parameters": [
      "solarDefaults"
    ],
    "items": {
      "type": "Container",
      "width": "100vw",
      "height": "100vh",
      "items": [
        {
          "type": "Frame",
          "width": "100vw",
          "height": "100vh",
          "borderRadius": "4dp",
          "background": {
            "type": "linear",
            "colorRange": ["#25485E", "#5D9FD3"],
            "inputRange": [0, 1],
            "angle": 160
          },
          "item": {
            "type": "Container",
            "width": "100%",
            "height": "100%",
            "paddingTop": "14dp",
            "paddingBottom": "12dp",
            "paddingLeft": "18dp",
            "paddingRight": "18dp",
            "justifyContent": "spaceBetween",
            "items": [
              {
                "type": "Container",
                "items": [
                  {
                    "type": "Text",
                    "text": "POTENZA ATTUALE",
                    "fontSize": "10dp",
                    "fontWeight": "600",
                    "color": "rgba(255,255,255,0.5)",
                    "letterSpacing": "1dp"
                  },
                  {
                    "type": "Container",
                    "direction": "row",
                    "alignItems": "center",
                    "spacing": "10dp",
                    "paddingTop": "2dp",
                    "items": [
                      {
                        "type": "Image",
                        "source": "https://alexa-fv-assets-126437.s3.eu-west-1.amazonaws.com/icons/icon-power.png",
                        "width": "34dp",
                        "height": "34dp",
                        "opacity": 0.5
                      },
                      {
                        "type": "Text",
                        "text": "${solarData.realTimePower ? solarData.realTimePower : solarDefaults.realTimePower}",
                        "fontSize": "58dp",
                        "fontWeight": "800",
                        "color": "#FFFFFF"
                      },
                      {
                        "type": "Text",
                        "text": "kW",
                        "fontSize": "18dp",
                        "fontWeight": "400",
                        "color": "rgba(255,255,255,0.45)"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Frame",
                "width": "100%",
                "height": "1dp",
                "backgroundColor": "rgba(255,255,255,0.12)"
              },
              {
                "type": "Container",
                "width": "100%",
                "paddingTop": "4dp",
                "paddingBottom": "4dp",
                "items": [
                  {
                    "type": "Container",
                    "direction": "row",
                    "width": "100%",
                    "items": [
                      {
                        "type": "Container",
                        "width": "20dp",
                        "height": "170dp",
                        "justifyContent": "spaceBetween",
                        "paddingRight": "3dp",
                        "items": [
                          {
                            "type": "Text",
                            "text": "4",
                            "fontSize": "7dp",
                            "color": "rgba(255,255,255,0.3)",
                            "textAlign": "right"
                          },
                          {
                            "type": "Text",
                            "text": "3",
                            "fontSize": "7dp",
                            "color": "rgba(255,255,255,0.3)",
                            "textAlign": "right"
                          },
                          {
                            "type": "Text",
                            "text": "2",
                            "fontSize": "7dp",
                            "color": "rgba(255,255,255,0.3)",
                            "textAlign": "right"
                          },
                          {
                            "type": "Text",
                            "text": "1",
                            "fontSize": "7dp",
                            "color": "rgba(255,255,255,0.3)",
                            "textAlign": "right"
                          },
                          {
                            "type": "Text",
                            "text": "0",
                            "fontSize": "7dp",
                            "color": "rgba(255,255,255,0.3)",
                            "textAlign": "right"
                          }
                        ]
                      },
                      {
                        "type": "VectorGraphic",
                        "grow": 1,
                        "height": "170dp",
                        "source": "miniCurveGraphic",
                        "scale": "fill",
                        "parameters": {
                          "areaPath": "${solarData.chartData.areaPath ? solarData.chartData.areaPath : 'M 0 120 L 40 100 L 80 70 L 120 35 L 160 12 L 200 5 L 240 12 L 280 40 L 320 80 L 360 105 L 400 120 L 400 120 L 0 120 Z'}",
                          "linePath": "${solarData.chartData.linePath ? solarData.chartData.linePath : 'M 0 120 L 40 100 L 80 70 L 120 35 L 160 12 L 200 5 L 240 12 L 280 40 L 320 80 L 360 105 L 400 120'}"
                        }
                      }
                    ]
                  },
                  {
                    "type": "Container",
                    "direction": "row",
                    "justifyContent": "spaceBetween",
                    "paddingLeft": "20dp",
                    "paddingTop": "3dp",
                    "items": [
                      {
                        "type": "Text",
                        "text": "08",
                        "fontSize": "7dp",
                        "color": "rgba(255,255,255,0.25)"
                      },
                      {
                        "type": "Text",
                        "text": "11",
                        "fontSize": "7dp",
                        "color": "rgba(255,255,255,0.25)"
                      },
                      {
                        "type": "Text",
                        "text": "14",
                        "fontSize": "7dp",
                        "color": "rgba(255,255,255,0.25)"
                      },
                      {
                        "type": "Text",
                        "text": "17",
                        "fontSize": "7dp",
                        "color": "rgba(255,255,255,0.25)"
                      },
                      {
                        "type": "Text",
                        "text": "20",
                        "fontSize": "7dp",
                        "color": "rgba(255,255,255,0.25)"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Frame",
                "width": "100%",
                "height": "1dp",
                "backgroundColor": "rgba(255,255,255,0.12)"
              },
              {
                "type": "Container",
                "paddingTop": "6dp",
                "spacing": "4dp",
                "items": [
                  {
                    "type": "Container",
                    "direction": "row",
                    "alignItems": "center",
                    "justifyContent": "spaceBetween",
                    "items": [
                      {
                        "type": "Container",
                        "direction": "row",
                        "alignItems": "center",
                        "spacing": "6dp",
                        "items": [
                          {
                            "type": "Image",
                            "source": "https://alexa-fv-assets-126437.s3.eu-west-1.amazonaws.com/icons/icon-today.png",
                            "width": "16dp",
                            "height": "16dp",
                            "opacity": 0.6
                          },
                          {
                            "type": "Text",
                            "text": "Oggi",
                            "fontSize": "12dp",
                            "fontWeight": "500",
                            "color": "rgba(255,255,255,0.6)"
                          }
                        ]
                      },
                      {
                        "type": "Container",
                        "direction": "row",
                        "alignItems": "baseline",
                        "spacing": "3dp",
                        "items": [
                          {
                            "type": "Text",
                            "text": "${solarData.dailyEnergy ? solarData.dailyEnergy : solarDefaults.dailyEnergy}",
                            "fontSize": "14dp",
                            "fontWeight": "700",
                            "color": "#FAFAFA"
                          },
                          {
                            "type": "Text",
                            "text": "kWh",
                            "fontSize": "9dp",
                            "fontWeight": "400",
                            "color": "rgba(255,255,255,0.4)"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Container",
                    "direction": "row",
                    "alignItems": "center",
                    "justifyContent": "spaceBetween",
                    "items": [
                      {
                        "type": "Container",
                        "direction": "row",
                        "alignItems": "center",
                        "spacing": "6dp",
                        "items": [
                          {
                            "type": "Image",
                            "source": "https://alexa-fv-assets-126437.s3.eu-west-1.amazonaws.com/icons/icon-month.png",
                            "width": "16dp",
                            "height": "16dp",
                            "opacity": 0.6
                          },
                          {
                            "type": "Text",
                            "text": "Mese",
                            "fontSize": "12dp",
                            "fontWeight": "500",
                            "color": "rgba(255,255,255,0.6)"
                          }
                        ]
                      },
                      {
                        "type": "Container",
                        "direction": "row",
                        "alignItems": "baseline",
                        "spacing": "3dp",
                        "items": [
                          {
                            "type": "Text",
                            "text": "${solarData.monthEnergy ? solarData.monthEnergy : solarDefaults.monthEnergy}",
                            "fontSize": "14dp",
                            "fontWeight": "700",
                            "color": "#FAFAFA"
                          },
                          {
                            "type": "Text",
                            "text": "kWh",
                            "fontSize": "9dp",
                            "fontWeight": "400",
                            "color": "rgba(255,255,255,0.4)"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "graphics": {
    "miniCurveGraphic": {
      "type": "AVG",
      "version": "1.2",
      "parameters": [
        "areaPath",
        "linePath"
      ],
      "width": 400,
      "height": 120,
      "items": [
        {
          "type": "path",
          "pathData": "M 0 0 L 400 0",
          "fill": "none",
          "stroke": "rgba(255,255,255,0.08)",
          "strokeWidth": 0.5,
          "strokeDashArray": [4, 4]
        },
        {
          "type": "path",
          "pathData": "M 0 30 L 400 30",
          "fill": "none",
          "stroke": "rgba(255,255,255,0.08)",
          "strokeWidth": 0.5,
          "strokeDashArray": [4, 4]
        },
        {
          "type": "path",
          "pathData": "M 0 60 L 400 60",
          "fill": "none",
          "stroke": "rgba(255,255,255,0.08)",
          "strokeWidth": 0.5,
          "strokeDashArray": [4, 4]
        },
        {
          "type": "path",
          "pathData": "M 0 90 L 400 90",
          "fill": "none",
          "stroke": "rgba(255,255,255,0.08)",
          "strokeWidth": 0.5,
          "strokeDashArray": [4, 4]
        },
        {
          "type": "path",
          "pathData": "${areaPath}",
          "fill": "rgba(255,255,255,0.12)",
          "stroke": "none"
        },
        {
          "type": "path",
          "pathData": "${linePath}",
          "fill": "none",
          "stroke": "rgba(255,255,255,0.6)",
          "strokeWidth": 1.5
        }
      ]
    }
  }
}

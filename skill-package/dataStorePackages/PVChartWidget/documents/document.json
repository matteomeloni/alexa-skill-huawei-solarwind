{
  "type": "APL",
  "version": "2024.3",
  "extensions": [
    {
      "name": "DataStore",
      "uri": "alexaext:datastore:10"
    }
  ],
  "settings": {
    "DataStore": {
      "dataBindings": [
        {
          "namespace": "fotovoltaico",
          "key": "realtime",
          "dataBindingName": "solarData",
          "dataType": "object"
        }
      ]
    }
  },
  "mainTemplate": {
    "parameters": [
      "solarDefaults"
    ],
    "items": {
      "type": "Container",
      "width": "100vw",
      "height": "100vh",
      "items": [
        {
          "type": "Frame",
          "width": "100vw",
          "height": "100vh",
          "borderRadius": "4dp",
          "background": {
            "type": "linear",
            "colorRange": ["#25485E", "#5D9FD3"],
            "inputRange": [0, 1],
            "angle": 160
          },
          "item": {
            "type": "Container",
            "width": "100%",
            "height": "100%",
            "paddingTop": "24dp",
            "paddingBottom": "24dp",
            "paddingLeft": "24dp",
            "paddingRight": "24dp",
            "justifyContent": "spaceBetween",
            "items": [
              {
                "type": "Container",
                "direction": "row",
                "alignItems": "center",
                "spacing": "8dp",
                "items": [
                  {
                    "type": "Image",
                    "source": "https://alexa-fv-assets-126437.s3.eu-west-1.amazonaws.com/icons/icon-power.png",
                    "width": "22dp",
                    "height": "22dp"
                  },
                  {
                    "type": "Text",
                    "text": "Fotovoltaico",
                    "fontSize": "20dp",
                    "fontWeight": "700",
                    "color": "#FAFAFA"
                  }
                ]
              },
              {
                "type": "Container",
                "paddingTop": "8dp",
                "items": [
                  {
                    "type": "Text",
                    "text": "POTENZA ATTUALE",
                    "fontSize": "11dp",
                    "fontWeight": "600",
                    "color": "rgba(255,255,255,0.5)",
                    "letterSpacing": "1dp"
                  },
                  {
                    "type": "Container",
                    "direction": "row",
                    "alignItems": "baseline",
                    "spacing": "6dp",
                    "paddingTop": "4dp",
                    "items": [
                      {
                        "type": "Text",
                        "text": "${solarData.realTimePower ? solarData.realTimePower : solarDefaults.realTimePower}",
                        "fontSize": "44dp",
                        "fontWeight": "800",
                        "color": "#FFFFFF"
                      },
                      {
                        "type": "Text",
                        "text": "kW",
                        "fontSize": "16dp",
                        "fontWeight": "400",
                        "color": "rgba(255,255,255,0.45)",
                        "paddingLeft": "4"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Container",
                "when": "${solarData.chartData.areaPath}",
                "width": "100%",
                "items": [
                  {
                    "type": "Container",
                    "direction": "row",
                    "width": "100%",
                    "items": [
                      {
                        "type": "Container",
                        "width": "22dp",
                        "height": "55dp",
                        "justifyContent": "spaceBetween",
                        "paddingRight": "3dp",
                        "data": "${solarData.chartData.yLabels}",
                        "items": [
                          {
                            "type": "Text",
                            "text": "${data.text}",
                            "fontSize": "8dp",
                            "fontWeight": "400",
                            "color": "rgba(255,255,255,0.3)",
                            "textAlign": "right"
                          }
                        ]
                      },
                      {
                        "type": "VectorGraphic",
                        "grow": 1,
                        "height": "55dp",
                        "source": "miniCurveGraphic",
                        "areaPath": "${solarData.chartData.areaPath}",
                        "linePath": "${solarData.chartData.linePath}"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Container",
                "items": [
                  {
                    "type": "Frame",
                    "width": "100%",
                    "height": "1dp",
                    "backgroundColor": "rgba(255,255,255,0.12)"
                  },
                  {
                    "type": "Container",
                    "paddingTop": "16dp",
                    "spacing": "14dp",
                    "items": [
                      {
                        "type": "Container",
                        "direction": "row",
                        "alignItems": "center",
                        "justifyContent": "spaceBetween",
                        "items": [
                          {
                            "type": "Container",
                            "direction": "row",
                            "alignItems": "center",
                            "spacing": "8dp",
                            "items": [
                              {
                                "type": "Image",
                                "source": "https://alexa-fv-assets-126437.s3.eu-west-1.amazonaws.com/icons/icon-today.png",
                                "width": "16dp",
                                "height": "16dp",
                                "opacity": 0.6
                              },
                              {
                                "type": "Text",
                                "text": "Oggi",
                                "fontSize": "14dp",
                                "fontWeight": "500",
                                "color": "rgba(255,255,255,0.6)"
                              }
                            ]
                          },
                          {
                            "type": "Container",
                            "direction": "row",
                            "alignItems": "baseline",
                            "spacing": "4dp",
                            "items": [
                              {
                                "type": "Text",
                                "text": "${solarData.dailyEnergy ? solarData.dailyEnergy : solarDefaults.dailyEnergy}",
                                "fontSize": "16dp",
                                "fontWeight": "700",
                                "color": "#FAFAFA"
                              },
                              {
                                "type": "Text",
                                "text": "kWh",
                                "fontSize": "11dp",
                                "fontWeight": "400",
                                "color": "rgba(255,255,255,0.4)",
                                "paddingLeft": "4"
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "Container",
                        "direction": "row",
                        "alignItems": "center",
                        "justifyContent": "spaceBetween",
                        "items": [
                          {
                            "type": "Container",
                            "direction": "row",
                            "alignItems": "center",
                            "spacing": "8dp",
                            "items": [
                              {
                                "type": "Image",
                                "source": "https://alexa-fv-assets-126437.s3.eu-west-1.amazonaws.com/icons/icon-month.png",
                                "width": "16dp",
                                "height": "16dp",
                                "opacity": 0.6
                              },
                              {
                                "type": "Text",
                                "text": "Mese",
                                "fontSize": "14dp",
                                "fontWeight": "500",
                                "color": "rgba(255,255,255,0.6)"
                              }
                            ]
                          },
                          {
                            "type": "Container",
                            "direction": "row",
                            "alignItems": "baseline",
                            "spacing": "4dp",
                            "items": [
                              {
                                "type": "Text",
                                "text": "${solarData.monthEnergy ? solarData.monthEnergy : solarDefaults.monthEnergy}",
                                "fontSize": "16dp",
                                "fontWeight": "700",
                                "color": "#FAFAFA"
                              },
                              {
                                "type": "Text",
                                "text": "kWh",
                                "fontSize": "11dp",
                                "fontWeight": "400",
                                "color": "rgba(255,255,255,0.4)",
                                "paddingLeft": "4"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Text",
                    "text": "Agg. ${solarData.lastUpdated ? solarData.lastUpdated : solarDefaults.lastUpdated}",
                    "fontSize": "10dp",
                    "fontWeight": "400",
                    "color": "rgba(255,255,255,0.25)",
                    "textAlign": "right",
                    "paddingTop": "12dp"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "graphics": {
    "miniCurveGraphic": {
      "type": "AVG",
      "version": "1.2",
      "parameters": [
        "areaPath",
        "linePath"
      ],
      "width": 400,
      "height": 120,
      "items": [
        {
          "type": "path",
          "pathData": "${areaPath}",
          "fill": "rgba(129,199,132,0.2)",
          "stroke": "none"
        },
        {
          "type": "path",
          "pathData": "${linePath}",
          "fill": "none",
          "stroke": "rgba(129,199,132,0.7)",
          "strokeWidth": 1
        }
      ]
    }
  }
}

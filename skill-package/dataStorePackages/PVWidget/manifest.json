              "solare",
              "energia",
              "produzione",
              "huawei"
            ],
            "iconUri": "https://alexa-fv-assets-126437.s3.eu-west-1.amazonaws.com/icons/widget-icon-450.png",
            "previews": [
              "https://alexa-fv-assets-126437.s3.eu-west-1.amazonaws.com/icons/widget-preview-328x552.png"
            ]
          }
        }
      ]
    }
  },
  "manifest": {
    "id": "PVWidget",
    "version": "1.0.0",
